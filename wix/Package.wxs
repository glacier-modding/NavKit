<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package Name="$(var.ProductName)"
             Manufacturer="$(var.ProductManufacturer)"
             Version="$(var.ProductVersion)"
             UpgradeCode="$(var.UpgradeCode)"
             Language="1033"
             Scope="$(var.InstallScope)">
        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <!--
            A major upgrade uninstalls the previous version before installing this one, which deletes
            the user's NavKit.ini; this package's default NavKit.ini is then installed in its place.
            The auto-updater works around that by copying NavKit.ini aside before running the MSI and
            restoring it as NavKit.ini.old, which NavKit merges into NavKit.ini on its next start.
            Do the same here so settings also survive running the MSI by hand: copy the installed
            version's NavKit.ini to NavKit.ini.old in the target folder before the old version is
            removed.

            This has to happen before the install script starts (RemoveExistingProducts runs between
            InstallValidate and InstallInitialize), so it is an immediate custom action rather than
            CopyFile/MoveFiles. Removing the old version only after installing the new one would keep
            NavKit.ini without a copy, but fails when the auto-updater of an installed version keeps
            DLLs in the install folder loaded (error 1310, rollback).
        -->
        <Property Id="PREVIOUSINSTALLFOLDER">
            <!-- Recorded by every version since 3.0 (RemoveFolderComponent below). -->
            <RegistrySearch Id="PreviousInstallFolderSearch" Root="HKCU"
                            Key="Software\$(var.ProductManufacturer)\$(var.ProductName)"
                            Name="Path" Type="raw" />
        </Property>
        <SetProperty Id="WixQuietExecCmdLine" Sequence="execute" After="CostFinalize"
                     Condition="WIX_UPGRADE_DETECTED AND PREVIOUSINSTALLFOLDER"
                     Value="&quot;[SystemFolder]cmd.exe&quot; /d /c if exist &quot;[PREVIOUSINSTALLFOLDER]NavKit.ini&quot; ( mkdir &quot;[INSTALLFOLDER].&quot; 2&gt;nul &amp; copy /y &quot;[PREVIOUSINSTALLFOLDER]NavKit.ini&quot; &quot;[INSTALLFOLDER]NavKit.ini.old&quot; )" />
        <CustomAction Id="PreservePreviousSettings" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                      Execute="immediate" Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="PreservePreviousSettings" After="SetWixQuietExecCmdLine"
                    Condition="WIX_UPGRADE_DETECTED AND PREVIOUSINSTALLFOLDER" />
        </InstallExecuteSequence>

        <MediaTemplate EmbedCab="true" />

        <ui:WixUI Id="WixUI_InstallDir"
              InstallDirectory="INSTALLFOLDER"
       />

        <Icon Id="icon.ico" SourceFile="$(var.ProductIcon)"/>
        <Property Id="ARPPRODUCTICON" Value="icon.ico"/>
        <Property Id="ARPCONTACT" Value="$(var.ProductContact)" />

        <Feature Id="MainFeature" Title="Main" Level="1">
            <ComponentGroupRef Id="NavKit_Components" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="RemoveFolderComponent" />
            <ComponentRef Id="NavKitExecutable" />
            <?if $(var.BulkTool) = 1?>
                <ComponentRef Id="BulkGenerationToolExecutable" />
                <ComponentRef Id="BulkGenerationToolShortcut" />
            <?endif?>
        </Feature>
    </Package>

    <Fragment>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="NavKit" />
        </StandardDirectory>
        <?if $(var.PerUserInstall) = 1?>
            <StandardDirectory Id="LocalAppDataFolder">
                <Directory Name="$(var.ProductManufacturer)">
                    <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
                </Directory>
            </StandardDirectory>
        <?else?>
            <StandardDirectory Id="ProgramFiles64Folder">
                <Directory Name="$(var.ProductManufacturer)">
                    <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
                </Directory>
            </StandardDirectory>
        <?endif?>
        <Component Id="ApplicationShortcut" Guid="40264e7c-a931-42c6-a8bd-25c8e3c71ec9" Directory="ApplicationProgramsFolder">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="NavKit"
                      Description="An app to create NAVP and AIRG files for use with Hitman"
                      Target="[#NavKit.exe]"
                      WorkingDirectory="INSTALLFOLDER" />

            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Glacier Modding\NavKit" Name="installed" Type="integer" Value="1" KeyPath="true"/>
        </Component>
        <?if $(var.BulkTool) = 1?>
            <Component Id="BulkGenerationToolShortcut" Guid="3f0d2b9e-6c1a-4f7e-9d52-8b4e1a7c6d20" Directory="ApplicationProgramsFolder">
                <Shortcut Id="BulkGenerationToolStartMenuShortcut"
                          Name="NavKit Bulk Generation Tool"
                          Description="Generates NAVP, AIRG and CRMD files for many Hitman missions at once"
                          Target="[#NavKitBulkGenerationTool.exe]"
                          WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\Glacier Modding\NavKit" Name="bulkGenerationToolShortcut" Type="integer" Value="1" KeyPath="true"/>
            </Component>
        <?endif?>
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="NavKitExecutable" Guid="d867f1ca-b135-4fc0-ad72-09b51e16826a">
                <File Id="NavKit.exe" Source="$(var.LayoutDir)\NavKit.exe" KeyPath="true" />
            </Component>
            <?if $(var.BulkTool) = 1?>
                <Component Id="BulkGenerationToolExecutable" Guid="9a7c4e21-5b3d-4c8f-a1e6-2d9f0b6c8e47">
                    <File Id="NavKitBulkGenerationTool.exe" Source="$(var.LayoutDir)\NavKitBulkGenerationTool.exe" KeyPath="true" />
                </Component>
            <?endif?>
            <Component Id="RemoveFolderComponent" Guid="*">
                <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="true" />
                <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="ProductCode" Type="string" Value="[ProductCode]" />
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>